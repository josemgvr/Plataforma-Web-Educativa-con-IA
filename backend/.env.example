# Plantilla de variables de entorno del backend.
# Copia este archivo como backend/.env y rellena tus propios valores.
# No subas nunca backend/.env al repositorio.

# Clave de API de Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Cadena de conexión de PostgreSQL/Supabase.
# Formato: postgresql://usuario:contraseña@host:puerto/basedatos
DATABASE_URL=

# --- Valores opcionales (si no se definen, se usan los de por defecto) ---

# Modelo de chat de Gemini. Por defecto: gemini-3.5-flash
# GEMINI_CHAT_MODEL=gemini-3.5-flash

# Modelo local de embeddings usado por el RAG.
# Por defecto: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
